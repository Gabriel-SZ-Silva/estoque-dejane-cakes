# Copie este arquivo para .env (cp .env.exemplo .env) e troque todos os valores.
# O .env guarda senhas: ele não vai para o zip nem para o Git.

# Endereço do sistema, sem https:// (o subdomínio criado no DuckDNS ou um domínio próprio)
DOMINIO=seusistema.duckdns.org

# Senhas do MySQL. Gere cada uma com:  openssl rand -base64 18
DB_SENHA=troque-esta-senha
DB_SENHA_ROOT=troque-esta-outra-senha

# Código pedido na tela "Primeiro acesso". Só vale enquanto a conta da dona (papel DONA) não existir.
CODIGO_INSTALACAO=troque-este-codigo
